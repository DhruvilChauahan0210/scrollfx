{
  "name": "scrollfx",
  "private": true,
  "description": "Scroll-driven sections for React and Tailwind, installed with the shadcn CLI. Built on svg-scroll-draw.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 4400",
    "build": "npm run registry && next build",
    "start": "next start -p 4400",
    "registry": "shadcn build && node scripts/build-vue-registry.mjs",
    "check": "node scripts/check.mjs",
    "readme:images": "node scripts/readme-images.mjs",
    "check:vue": "node scripts/check-vue.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "geist": "^1.9.2",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^3.0.0",
    "svg-scroll-draw": "^2.27.3",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vue/compiler-sfc": "^3.5.45",
    "esbuild": "^0.25.12",
    "playwright": "1.65.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vue": "^3.5.45"
  }
}
